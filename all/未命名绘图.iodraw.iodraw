        </mxCell>
        <mxCell id="ulvBigd-cj4FRAXkyN0Y-244" value="\(\Delta_\theta\le\varepsilon_\theta\)?" style="rhombus;strokeWidth=2;whiteSpace=wrap;html=1;" vertex="1" parent="1">
