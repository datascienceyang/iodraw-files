    <mxGraphModel dx="1176" dy="1709" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ulvBigd-cj4FRAXkyN0Y-233" value="输入 \(S_1,\theta_1,\delta=1^\circ\)" style="whiteSpace=wrap;strokeWidth=2;html=1;" vertex="1" parent="1">
          <mxGeometry x="745" y="200" width="258" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ulvBigd-cj4FRAXkyN0Y-234" value="构建 \(F_1^{\mathrm{ex}},\ F_1^+\)" style="whiteSpace=wrap;strokeWidth=2;html=1;" vertex="1" parent="1">
          <mxGeometry x="751" y="316" width="244" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ulvBigd-cj4FRAXkyN0Y-235" value="保证接收域 &#xa; \(K_1^+:\ \sup_{G\in F_1^+}\|S_2-G\|_2\le 1000\)" style="whiteSpace=wrap;strokeWidth=2;html=1;" vertex="1" parent="1">
          <mxGeometry x="751" y="433" width="246" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ulvBigd-cj4FRAXkyN0Y-236" value="多边形逼近 &#xa; \(P_N^-\subseteq F_1^+\subseteq P_N^+\)" style="whiteSpace=wrap;strokeWidth=2;html=1;" vertex="1" parent="1">
          <mxGeometry x="763" y="567" width="220" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ulvBigd-cj4FRAXkyN0Y-237" value="定义 &#xa; \(J(S_2)=\sup_{z_2}R_{\min}(F_1^+\cap W(S_2,z_2,\delta))\)" style="whiteSpace=wrap;strokeWidth=2;html=1;" vertex="1" parent="1">
          <mxGeometry x="746" y="701" width="254" height="102" as="geometry" />
        </mxCell>
        <mxCell id="ulvBigd-cj4FRAXkyN0Y-238" value="纯定位目标 &#xa; \(J^*=\inf_{S_2\in K_1^+}J(S_2)\)" style="whiteSpace=wrap;strokeWidth=2;html=1;" vertex="1" parent="1">
          <mxGeometry x="787" y="852" width="173" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ulvBigd-cj4FRAXkyN0Y-239" value="候选域 &#xa; \(\mathcal C_\rho=\{S_2:J(S_2)\le(1+\rho)J^*\}\)" style="whiteSpace=wrap;strokeWidth=2;html=1;" vertex="1" parent="1">
          <mxGeometry x="757" y="986" width="233" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ulvBigd-cj4FRAXkyN0Y-240" value="推荐点 &#xa; \(S_2^{\mathrm{rec}}(\rho)\in\arg\min_{\mathcal C_\rho}\|S_2-S_1\|\)" style="whiteSpace=wrap;strokeWidth=2;html=1;" vertex="1" parent="1">
          <mxGeometry x="664" y="1120" width="252" height="102" as="geometry" />
        </mxCell>
        <mxCell id="ulvBigd-cj4FRAXkyN0Y-241" value="三层搜索: 粗搜 \(K_1^+\) &amp;rarr; 5m 候选 &amp;rarr; 细复核" style="whiteSpace=wrap;strokeWidth=2;html=1;" vertex="1" parent="1">
          <mxGeometry x="682" y="1272" width="217" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ulvBigd-cj4FRAXkyN0Y-242" value="连续角度证书 \(L_k\le J\le U_k\)" style="whiteSpace=wrap;strokeWidth=2;html=1;" vertex="1" parent="1">
          <mxGeometry x="673" y="1406" width="236" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ulvBigd-cj4FRAXkyN0Y-243" value="自适应二分细化" style="whiteSpace=wrap;strokeWidth=2;html=1;" vertex="1" parent="1">
